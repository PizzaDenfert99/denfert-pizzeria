# Pizza Denfert — example environment for self-hosted Docker deployment.
#
# Copy this file to `.env` in the repo root on your VPS, fill in real values,
# then run `docker compose up -d --build`. Docker Compose auto-loads `.env`.
#
# NEVER commit the real .env file (see .gitignore).

# ---- REQUIRED ---------------------------------------------------------------
DB_NAME=pizzadenfert
# Generate a strong secret with:  openssl rand -hex 32
JWT_SECRET=replace-me-with-64-hex-chars

# ---- SUPABASE (menu CMS) ----------------------------------------------------
# Single Supabase project shared by ALL clients (customer web, customer app,
# and the future tablet-qr-scanner). New project (2026-06-30 migration):
SUPABASE_URL=https://fuxyinngmdzzoumloenv.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# ---- OTP / SMS — OPTIONAL (empty SMS_PROVIDER = DEMO MODE) ------------------
SMS_PROVIDER=
OTP_DEMO_MODE=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OVH_APP_KEY=
OVH_APP_SECRET=
OVH_CONSUMER_KEY=
OVH_SMS_SERVICE=
OVH_SMS_SENDER=

# ---- Web Push / VAPID — OPTIONAL --------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:contact@pizzadenfert.fr

# ---- Emergent native push — OPTIONAL ----------------------------------------
EMERGENT_PUSH_KEY=placeholder
