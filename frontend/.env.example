# Pizza Denfert — Customer app (Expo) — example environment configuration.
#
# Copy to `frontend/.env` and adjust for your environment. The customer app
# talks to the SHARED backend that also powers the loyalty/POS tablet app
# (one backend, one MongoDB, one Supabase project — one source of truth).
#
# Production (default):
EXPO_PUBLIC_BACKEND_URL=https://loyalty.pizzadenfert.fr

# ---- Supabase (menu CMS, public data) --------------------------------------
# Same Supabase project used by the loyalty admin panel. The ANON key is safe
# to expose in a mobile app (RLS on server side enforces row-level access).
# New project (2026-06-30 migration): fuxyinngmdzzoumloenv
EXPO_PUBLIC_SUPABASE_URL=https://fuxyinngmdzzoumloenv.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ---- Local dev (uncomment when running the loyalty backend locally) --------
# EXPO_PUBLIC_BACKEND_URL=http://localhost:8001
