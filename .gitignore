# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# IDE and editors
.idea/
.vscode/

# Dependencies
node_modules/
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# Production builds
/build
dist/
dist

# Environment files (comprehensive coverage)

*token.json*
*credentials.json*

# Logs and debug files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dump.rdb

# System files
.DS_Store
*.pem

# Python
__pycache__/
*pyc*
venv/
.venv/

# Development tools
chainlit.md
.chainlit
.ipynb_checkpoints/
.ac

# Deployment
.vercel

# Data and databases
agenthub/agents/youtube/db

# Archive files and large assets
**/*.zip
**/*.tar.gz
**/*.tar
**/*.tgz
*.pack
*.deb
*.dylib

# Build caches
.cache/

memory/test_credentials.md

# Mobile development
android-sdk/
# .env files: the customer app's frontend/.env is intentionally tracked so the
# Emergent deploy pipeline can pick up MONGO_URL / DB_NAME / EXPO_PUBLIC_*
# variables baked at build time. All OTHER .env files stay ignored.
.env
.env.*
*.env
!frontend/.env
!frontend/.env.example
!backend/.env.example
!.env.docker.example
# SSH deploy keys used by the Emergent runtime — must NEVER leak.
.deploy/
id_ed25519
id_ed25519.pub

# Per-build secrets that must NEVER be committed:
google-services.json
play-store-service-account.json
credentials.json
*.key
.credentials

# Distributable build artifacts dropped for direct download (nginx serves
# these at /downloads/ — see docker-compose.yml + nginx/nginx.conf).
nginx/downloads/*
!nginx/downloads/.gitkeep
frontend/.metro-cache/
