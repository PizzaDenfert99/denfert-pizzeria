# Pizza Denfert — Customer app backend environment.
#
# The customer app in this repo is a PURE FRONTEND that talks to the SHARED
# backend located in `PizzaDenfert99/pizza-denfert-loyalty` (deployed at
# https://api.pizzadenfert.fr and https://loyalty.pizzadenfert.fr).
#
# This `backend/` folder is kept only so that the Emergent preview environment
# can spin up a LOCAL copy of the API for development. The canonical backend
# source of truth is the loyalty repo — the file `backend/server.py` here is
# a byte-for-byte copy synced via the `sync/align-backend-*` branches.
#
# Copy this file to `backend/.env` and fill in real values for LOCAL dev only.
# NEVER commit `backend/.env` — production secrets live on the VPS.
#
# ---- REQUIRED ---------------------------------------------------------------
MONGO_URL="mongodb://127.0.0.1:27017"
DB_NAME="pizzadenfert"
# Generate with: openssl rand -hex 32
JWT_SECRET="replace-me-with-64-hex-chars"

# ---- SUPABASE (menu CMS) ----------------------------------------------------
# Same Supabase project used by the loyalty repo. New project (2026-06-30):
SUPABASE_URL="https://fuxyinngmdzzoumloenv.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_ANON_KEY=""

# ---- OTP / SMS — OPTIONAL (empty SMS_PROVIDER = DEMO MODE) ------------------
SMS_PROVIDER=""
OTP_DEMO_MODE="true"

# ---- Web Push / VAPID — OPTIONAL --------------------------------------------
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_CONTACT="mailto:contact@pizzadenfert.fr"

# ---- Emergent native push — OPTIONAL ----------------------------------------
EMERGENT_PUSH_KEY="placeholder"
